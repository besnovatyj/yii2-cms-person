{
  "name": "besnovatyj/yii2-cms-person",
  "description": "Модуль управления актёрами для Yii2 CMS",
  "version": "1.0.0",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\Person\\Module",
    "moduleId": "Person",
    "bescms": { "kind": "module" }
  },
  "keywords": [
    "yii2",
    "person",
    "cms"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0",
    "besnovatyj/yii2-cms-meta": "1.0.0",
    "besnovatyj/yii2-cms-images": "1.0.0",
    "besnovatyj/yii2-nested-sets": "^1.1"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Person\\": "src/"
    }
  }
}
